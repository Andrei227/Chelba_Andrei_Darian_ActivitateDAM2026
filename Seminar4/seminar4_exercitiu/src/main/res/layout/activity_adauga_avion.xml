<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".adauga_avion">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adauga un avion"
        android:textSize="20dp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Model"
        android:inputType="text" />

    <EditText
        android:id="@+id/etCapacitate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Capacitate pasageri"
        android:inputType="number"
        android:layout_marginBottom="10dp" />

    <Spinner
        android:id="@+id/spinnerCompanie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/companii_aeriene_array"
        android:layout_marginBottom="10dp" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbIntern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intern"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rbExtern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extern" />

    </RadioGroup>

    <CheckBox
        android:id="@+id/cbMancare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meniu inclus" />

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="0.5" />

    <Switch
        android:id="@+id/switchDisponibil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Disponibil"
        android:checked="true"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSalveaza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salveaza"
        android:onClick="intoarceRezultat" />



</LinearLayout>